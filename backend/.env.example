# ---- Database ----
DATABASE_URL=postgresql+psycopg://enterpriseiq:enterpriseiq@postgres:5432/enterpriseiq
# Used only by the test suite (a separate, disposable database)
TEST_DATABASE_URL=postgresql+psycopg://enterpriseiq:enterpriseiq@localhost:5432/enterpriseiq_test

# ---- Auth ----
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Ollama (local models only; no API keys anywhere) ----
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_LLM_MODEL=mistral
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.2
# How long the API waits for Ollama at startup before serving anyway (AI endpoints then return 503)
OLLAMA_STARTUP_WAIT_SECONDS=30

# ---- RAG ----
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=6
SIMILARITY_THRESHOLD=0.45
MAX_CONTEXT_CHARS=12000
SUMMARY_SECTION_CHARS=8000

# ---- Files ----
MAX_FILE_SIZE=20971520
UPLOAD_DIR=/data/uploads

# ---- HTTP ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO

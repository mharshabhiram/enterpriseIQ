# Copy this file to .env and fill in real values.
# Never commit the real .env file.

APP_ENV=development
DEBUG=true

# --- Database (matches docker-compose.yml postgres service) ---
DATABASE_URL=postgresql+asyncpg://enterpriseiq:enterpriseiq@postgres:5432/enterpriseiq

# --- JWT ---
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- LLM provider (provider-agnostic; see app/ai) ---
# 'openai' (default, real, requires LLM_API_KEY) or 'mock' (deterministic,
# offline, no API key needed - for local dev/CI/demos; never use in production)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# --- Embedding provider ---
# 'openai' (default, real, requires EMBEDDING_API_KEY) or 'mock' (deterministic,
# offline, no API key needed - for local dev/CI/demos; never use in production)
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BASE_URL=

# --- RAG / retrieval tuning ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
SIMILARITY_THRESHOLD=0.75
MAX_CONTEXT_LENGTH=6000

# --- Uploads ---
MAX_FILE_SIZE=26214400
UPLOAD_DIR=/app/uploads

# --- CORS (JSON array of allowed origins) ---
CORS_ORIGINS=["http://localhost:5173"]

# --- Rate limiting ---
# Set to false only for local debugging if it gets in the way; keep true
# everywhere else, including production.
RATE_LIMIT_ENABLED=true
